<view class="container">
  <view class="loading-mask" wx:if="{{loading}}">
    <view class="loading-spinner"></view>
    <text class="loading-text">加载中...</text>
  </view>

  <view class="announcement-content-page" wx:if="{{announcement && !loading}}">
    <view class="announcement-header card">
      <view class="announcement-badge">公告</view>
      <view class="announcement-title">{{announcement.title}}</view>
      <view class="announcement-date">
        发布时间：{{announcement.publishDate || announcement.created_at}}
      </view>
    </view>

    <view class="announcement-content card">
      <view class="card-title">公告内容</view>
      <view class="content-text">{{announcement.content}}</view>
    </view>
  </view>
</view>

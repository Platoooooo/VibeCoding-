.announcement-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.announcement-card {
  padding: 24rpx;
}

.announcement-header {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.announcement-badge {
  background: #ff4d4f;
  color: #fff;
  font-size: 22rpx;
  padding: 4rpx 12rpx;
  border-radius: 4rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.announcement-title {
  flex: 1;
  font-size: 30rpx;
  font-weight: bold;
  color: var(--text-color);
  line-height: 1.4;
}

.announcement-content {
  font-size: 26rpx;
  color: var(--text-secondary);
  line-height: 1.5;
  margin-bottom: 16rpx;
}

.announcement-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.announcement-date {
  font-size: 24rpx;
  color: var(--text-light);
}

.arrow {
  font-size: 36rpx;
  color: var(--text-light);
}

.no-more {
  padding: 30rpx;
  text-align: center;
  color: var(--text-light);
  font-size: 26rpx;
}

/* 加载遮罩层 */
.loading-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  z-index: 9999;
}

.loading-spinner {
  width: 80rpx;
  height: 80rpx;
  border: 6rpx solid #ffffff;
  border-top-color: var(--primary-color);
  border-radius: 50%;
  animation: spin 1s linear infinite;
}

.loading-text {
  color: #ffffff;
  font-size: 28rpx;
  margin-top: 20rpx;
}

@keyframes spin {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

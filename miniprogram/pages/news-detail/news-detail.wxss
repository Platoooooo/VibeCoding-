.news-cover {
  width: 100%;
  height: 400rpx;
  margin-bottom: 20rpx;
  border-radius: 12rpx;
  overflow: hidden;
}

.cover-image {
  width: 100%;
  height: 100%;
}

.news-header {
  margin-bottom: 20rpx;
}

.news-title {
  font-size: 36rpx;
  font-weight: bold;
  color: var(--text-color);
  line-height: 1.4;
  margin-bottom: 20rpx;
}

.news-meta {
  display: flex;
  justify-content: space-between;
  font-size: 24rpx;
  color: var(--text-light);
}

.news-content {
  margin-bottom: 20rpx;
}

.content-text {
  font-size: 28rpx;
  color: var(--text-secondary);
  line-height: 1.8;
  margin-top: 20rpx;
  white-space: pre-wrap;
}

/* 加载遮罩层 */
.loading-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  z-index: 9999;
}

.loading-spinner {
  width: 80rpx;
  height: 80rpx;
  border: 6rpx solid #ffffff;
  border-top-color: var(--primary-color);
  border-radius: 50%;
  animation: spin 1s linear infinite;
}

.loading-text {
  color: #ffffff;
  font-size: 28rpx;
  margin-top: 20rpx;
}

@keyframes spin {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

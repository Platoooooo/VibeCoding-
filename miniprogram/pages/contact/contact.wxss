.contact-card {
  margin-bottom: 20rpx;
}

.company-title {
  display: flex;
  align-items: center;
  margin-bottom: 30rpx;
  padding-bottom: 30rpx;
  border-bottom: 1rpx solid var(--border-color);
}

.company-icon {
  font-size: 60rpx;
  margin-right: 20rpx;
}

.company-name {
  font-size: 36rpx;
  font-weight: bold;
  color: var(--text-color);
}

.info-item {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--border-color);
}

.info-item:last-child {
  border-bottom: none;
}

.info-icon {
  font-size: 40rpx;
  margin-right: 20rpx;
  width: 50rpx;
  text-align: center;
}

.info-content {
  flex: 1;
}

.info-label {
  font-size: 24rpx;
  color: var(--text-light);
  margin-bottom: 8rpx;
}

.info-value {
  font-size: 28rpx;
  color: var(--text-color);
}

.info-action {
  color: var(--primary-color);
  font-size: 28rpx;
  padding: 10rpx 20rpx;
  background: #e6f7ff;
  border-radius: 4rpx;
}

.worktime-card {
  margin-bottom: 20rpx;
}

.worktime-list {
  margin-top: 20rpx;
}

.worktime-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--border-color);
}

.worktime-item:last-child {
  border-bottom: none;
}

.worktime-label {
  font-size: 28rpx;
  color: var(--text-secondary);
}

.worktime-value {
  font-size: 28rpx;
  color: var(--text-color);
  font-weight: bold;
}

.map-card {
  margin-bottom: 20rpx;
}

.contact-map {
  width: 100%;
  height: 400rpx;
  margin-top: 20rpx;
  border-radius: 8rpx;
}

.action-buttons {
  display: flex;
  gap: 20rpx;
  margin-top: 40rpx;
}

.action-btn {
  flex: 1;
  font-size: 28rpx;
}

/* 加载遮罩层 */
.loading-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  z-index: 9999;
}

.loading-spinner {
  width: 80rpx;
  height: 80rpx;
  border: 6rpx solid #ffffff;
  border-top-color: var(--primary-color);
  border-radius: 50%;
  animation: spin 1s linear infinite;
}

.loading-text {
  color: #ffffff;
  font-size: 28rpx;
  margin-top: 20rpx;
}

@keyframes spin {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

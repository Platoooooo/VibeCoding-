.product-images-section {
  position: relative;
  margin-bottom: 20rpx;
  background-color: #000;
}

.product-swiper {
  width: 100%;
  height: 55vh;
}

.product-image {
  width: 100%;
  height: 55vh;
  object-fit: contain;
}

.product-image-placeholder {
  width: 100%;
  height: 55vh;
  background-color: var(--bg-color);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 60rpx;
  color: var(--text-light);
}

.image-indicator {
  position: absolute;
  bottom: 20rpx;
  right: 20rpx;
  background: rgba(0, 0, 0, 0.6);
  color: #ffffff;
  padding: 10rpx 20rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
}

.product-info {
  margin-bottom: 20rpx;
}

.product-name {
  font-size: 36rpx;
  font-weight: bold;
  color: var(--text-color);
  line-height: 1.4;
  margin-bottom: 20rpx;
}

.product-model,
.product-no,
.product-category {
  font-size: 26rpx;
  color: var(--text-secondary);
  margin-bottom: 12rpx;
}

.label {
  color: var(--text-light);
}

.value {
  color: var(--text-secondary);
}

.product-price {
  font-size: 48rpx;
  color: #ff4d4f;
  font-weight: bold;
  margin: 20rpx 0;
}

.price-symbol {
  font-size: 32rpx;
}

.price-unit {
  font-size: 28rpx;
  color: var(--text-secondary);
  font-weight: normal;
}

.product-spec,
.product-features,
.product-description {
  margin-bottom: 20rpx;
}

.spec-content,
.description-content {
  font-size: 28rpx;
  color: var(--text-secondary);
  line-height: 1.8;
  margin-top: 20rpx;
  white-space: pre-wrap;
}

.feature-list {
  margin-top: 20rpx;
}

.feature-item {
  display: flex;
  align-items: flex-start;
  padding: 16rpx 0;
  border-bottom: 1rpx solid var(--border-color);
}

.feature-item:last-child {
  border-bottom: none;
}

.feature-icon {
  color: #52c41a;
  font-size: 32rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.feature-text {
  font-size: 28rpx;
  color: var(--text-secondary);
  line-height: 1.6;
  flex: 1;
}

.tips-section {
  padding: 30rpx 0;
  margin-top: 20rpx;
}

.tip-item {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  font-size: 24rpx;
  color: var(--text-light);
}

.tip-icon {
  margin-right: 16rpx;
  font-size: 28rpx;
}

.tip-text {
  flex: 1;
}

/* 加载遮罩层 */
.loading-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  z-index: 9999;
}

.loading-spinner {
  width: 80rpx;
  height: 80rpx;
  border: 6rpx solid #ffffff;
  border-top-color: var(--primary-color);
  border-radius: 50%;
  animation: spin 1s linear infinite;
}

.loading-text {
  color: #ffffff;
  font-size: 28rpx;
  margin-top: 20rpx;
}

@keyframes spin {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

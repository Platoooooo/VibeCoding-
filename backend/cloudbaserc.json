version: "1.0"
metadata:
  name: wxzz-prod
  namespace: default
spec:
  containers:
    - name: main
      image: ccr.ccs.tencentyun.com/wxcloudrun/springboot:latest
      ports:
        - containerPort: 80
          protocol: TCP
      env:
        - name: SPRING_DATASOURCE_URL
          valueFrom:
            secretKeyRef:
              name: db-config
              key: url
        - name: SPRING_DATASOURCE_USERNAME
          valueFrom:
            secretKeyRef:
              name: db-config
              key: username
        - name: SPRING_DATASOURCE_PASSWORD
          valueFrom:
            secretKeyRef:
              name: db-config
              key: password
        - name: SERVER_PORT
          value: "80"
      resources:
        limits:
          cpu: 500m
          memory: 512Mi
        requests:
          cpu: 250m
          memory: 256Mi
      volumeMounts:
        - name: uploads
          mountPath: /app/uploads
  volumes:
    - name: uploads
      persistentVolumeClaim:
        claimName: uploads-pvc
  replicas: 1

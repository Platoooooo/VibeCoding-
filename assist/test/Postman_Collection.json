					"name": "0. 登录认证",
					"item": [
						{
							"name": "管理员登录",
							"event": [
								{
									"listen": "test",
									"script": {
										"exec": [
											"var jsonData = pm.response.json();",
											"if (jsonData.code === 0 && jsonData.data && jsonData.data.token) {",
											"    pm.environment.set('token', jsonData.data.token);",
											"    console.log('Token已保存:', jsonData.data.token);",
											"} else {",
											"    console.error('登录失败:', jsonData.message);",
											"}"
										],
										"type": "text/javascript"
									}
								}
							],
							"request": {
								"method": "POST",
								"header": [
									{
										"key": "Content-Type",
										"value": "application/json"
									}
								],
								"body": {
									"mode": "raw",
									"raw": "{\n  \"username\": \"admin\",\n  \"password\": \"admin123\"\n}"
								},
								"url": {
									"raw": "{{baseUrl}}/admin/login",
									"host": ["{{baseUrl}}"],
									"path": ["admin", "login"]
								},
								"description": "管理员登录，成功后自动保存Token到环境变量"
							},
							"response": []
						}
					]
				},
